# OIDC
PALPO_OIDC__ENABLE=true
PALPO_OIDC__DEFAULT_PROVIDER=sso
PALPO_OIDC__USER_PREFIX=oauth_
PALPO_OIDC__ALLOW_REGISTRATION=true
PALPO_OIDC__ENABLE_PKCE=true
PALPO_OIDC__USER_MAPPING=email
PALPO_OIDC__SESSION_TIMEOUT=600

PALPO_OIDC__PROVIDERS__SSO__ISSUER=https://keycloak.example.com/oauth2/openid/palpo
PALPO_OIDC__PROVIDERS__SSO__CLIENT_ID=palpo
PALPO_OIDC__PROVIDERS__SSO__CLIENT_SECRET=<your_client_secret>
PALPO_OIDC__PROVIDERS__SSO__REDIRECT_URI=https://matrix.example.com/_matrix/client/oidc/callback
PALPO_OIDC__PROVIDERS__SSO__SCOPES='["openid", "profile", "email", "groups"]'
PALPO_OIDC__PROVIDERS__SSO__DISPLAY_NAME="Sign in with SSO"
PALPO_OIDC__PROVIDERS__SSO__REQUIRE_EMAIL_VERIFIED=true
PALPO_OIDC__PROVIDERS__SSO__SKIP_TLS_VERIFY=false
PALPO_OIDC__PROVIDERS__SSO__ATTRIBUTE_MAPPING='{ "preferred_username" = "nickname", "display_name" = "given_name", "avatar_url" = "picture" }'