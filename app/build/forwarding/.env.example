# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, forwarding/.env.example, s3-storage/.env.example, pgrust/.env.example, oidc/.env.example, turn/.env.example

# Project name for Docker Compose
COMPOSE_PROJECT_NAME=palpo

IMAGE=palpo/palpo:latest
# IMAGE=ghcr.io/palpo-im/palpo:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true


PALPO_CONFIG=/var/palpo/palpo.toml

PALPO_ADDRESS=0.0.0.0:8008
PALPO_LISTEN_ADDR=0.0.0.0:8008
PALPO_SERVER_NAME=matrix.com
PALPO_TRUSTED_SERVERS='["matrix.org", "mozilla.org"]'
PALPO_MAX_UPLOAD_SIZE=20000000
PALPO_ALLOW_REGISTRATION=false
# Extra
PALPO_FEDERATION__ENABLE=false
PALPO_PRESENCE__ALLOW_LOCAL=true
# Security (Login)
PALPO_RC_LOGIN__PER_SECOND=9999.0
PALPO_RC_LOGIN__BURST=9999
# Security (Registration)
PALPO_RC_REGISTRATION__PER_SECOND=9999.0
PALPO_RC_REGISTRATION__BURST=9999
# Security (Password)
PALPO_RC_PASSWORD__PER_SECOND=9999.0
PALPO_RC_PASSWORD__BURST=9999
# Security (Message)
PALPO_RC_MESSAGE__PER_SECOND=9999.0
PALPO_RC_MESSAGE__BURST=9999
# Forwarding
DB_PORT=5432
PALPO_PORT=8008
# S3 Storage
PALPO_STORAGE__BACKEND=s3
PALPO_STORAGE__ENDPOINT=https://s3.amazonaws.com
PALPO_STORAGE__ACCESS_KEY_ID=myaccesskey
PALPO_STORAGE__SECRET_ACCESS_KEY=mysecretkey
PALPO_STORAGE__BUCKET=apps
PALPO_STORAGE__REGION=us-east-1
PALPO_STORAGE__PREFIX="palpo/"
PALPO_STORAGE_PATH_STYLE=true
PALPO_STORAGE_REDIRECT=true
PALPO_STORAGE_PRESIGN_EXPIRY=300
# PostgreSQL (Optional)
COMPOSE_EXTENDS=:docker-compose.db.yml
COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}

TZ=Europe/Moscow
POSTGRES_DB=palpo
POSTGRES_USER=palpo
POSTGRES_PASSWORD=changeme
POSTGRES_INITDB_ARGS="--encoding=UTF8 --lc-ctype=C --lc-collate=C"

# PostgreSQL
POSTGRES_HOST=palpo-db:5432
PALPO_DB__URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}
PALPO_DB_POOL__SIZE=10
# OIDC
PALPO_OIDC__ENABLE=true
PALPO_OIDC__DEFAULT_PROVIDER=kanidm
PALPO_OIDC__ALLOW_REGISTRATION=true
PALPO_OIDC__ENABLE_PKCE=true
PALPO_OIDC__USER_MAPPING=email
PALPO_OIDC__SESSION_TIMEOUT=600

PALPO_OIDC__PROVIDERS__SSO__ISSUER=https://keycloak.example.com/oauth2/openid/palpo
PALPO_OIDC__PROVIDERS__SSO__CLIENT_ID=palpo
PALPO_OIDC__PROVIDERS__SSO__CLIENT_SECRET=<your_client_secret>
PALPO_OIDC__PROVIDERS__SSO__REDIRECT_URI=https://matrix.example.com/_matrix/client/oidc/callback
PALPO_OIDC__PROVIDERS__SSO__SCOPES='["openid", "profile", "email", "groups"]'
PALPO_OIDC__PROVIDERS__SSO__DISPLAY_NAME="Sign in with SSO"
# TURN
PALPO_TURN__URIS='["turns:example.com?transport=udp", "turns:example.com?transport=tcp"]'
# PALPO_TURN_URIS='["turn:example.com?transport=udp", "turn:example.com?transport=tcp"]'
PALPO_TURN__SHARED_SECRET=Z11ZugvTopHBxq4FatCOKV52vghfFKE8MfOAMBlhAbWFA4WQPXhkuq834DEl31sE